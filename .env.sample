# Slack App Credentials
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-token

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=your-deepseek-key
# Record card display (optional)
SF_CURRENCY=IDR
DISPLAY_TZ=Asia/Jakarta

# Google Drive (read files shared as links, per-user OAuth). Leave empty to disable.
# Create an OAuth client (Web application) in Google Cloud, enable the Google Drive API, add the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS URL of this server's callback, e.g. https://lori.example.com/oauth/google/callback
GOOGLE_REDIRECT_URI=
# 64 hex chars (encrypts stored refresh tokens): openssl rand -hex 32
GOOGLE_TOKEN_KEY=
# Optional: only accept this Google Workspace domain
GOOGLE_ALLOWED_DOMAIN=
# Optional: local port for the OAuth callback server (default 3000) and token file (default ./data/google-tokens.json)
OAUTH_PORT=3000
# Bind address of the callback server; keep 127.0.0.1 when a reverse proxy runs on the same machine
# OAUTH_HOST=127.0.0.1

# File reading limits / models (optional)
# MARKITDOWN_BIN=markitdown
# OPENAI_PDF_MODEL=gpt-4o-mini
# FILE_MAX_MB=25
# FILE_MAX_CHARS=30000
# PDF_MIN_CHARS_PER_PAGE=150
# PDF_MAX_PAGES=100
# PDF_VISION_MAX_MB=20
